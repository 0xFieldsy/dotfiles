[core]
	autocrlf = input
	pager = less -FRSX --tabs=2
[credential]
	helper = store --file ~/.git-credentials
[color]
	ui = always
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
[init]
	defaultBranch = main
[push]
	default = simple
[pull]
	rebase = false
	ff = only
[diff]
	tool = nvimdiff2
	color = always
	colorMoved = default
[difftool]
	prompt = false
[merge]
	tool = nvimdiff2
[mergetool]
	prompt = false
	keepBackup = false
[safe]
	directory = *
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
