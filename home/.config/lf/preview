#!/usr/bin/env bash
set -euo pipefail

file="$1"
width="${2:-80}"
height="${3:-40}"

# requires file, chafa, and bat
if [[ -z $(command -v file 2>/dev/null) || -z $(command -v chafa 2>/dev/null) || -z $(command -v bat 2>/dev/null) ]]; then
  cat -- "$file"
  exit
fi

mime="$(file --mime-type -Lb -- "$file")"
case "$mime" in
  image/*)
    # lf passes pane size in character cells
    chafa -f symbols -s "${width}x${height}" -- "$file"
    ;;
  *)
    bat --plain --color=always --paging=never --terminal-width "$width" -- "$file" || true
    ;;
esac
