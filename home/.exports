# shellcheck shell=sh
# move to the front of PATH, removing any other copies
path_prepend() {
  PATH=":${PATH}:"
  while case $PATH in *":$1:"*) true ;; *) false ;; esac; do
    PATH="${PATH%%:"$1":*}:${PATH#*:"$1":}"
  done
  PATH="${PATH#:}"
  PATH="${PATH%:}"
  PATH="$1${PATH:+:${PATH}}"
}

# linux
if [ "$(uname -s)" = 'Linux' ] ; then
  # wsl
  if [ -d '/usr/lib/wsl' ] ; then
    export LD_LIBRARY_PATH="/usr/lib/wsl/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
  fi

  # rocm
  ROCM_PATH='/opt/rocm'
  if [ -d "${ROCM_PATH}" ] ; then
    export ROCM_PATH
    path_prepend "${ROCM_PATH}/bin"
    export LD_LIBRARY_PATH="${ROCM_PATH}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
    export TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1
    if [ -e "${ROCM_PATH}/lib/librocdxg.so" ] ; then
      export HSA_ENABLE_DXG_DETECTION=1
    fi
  fi

  # cuda
  CUDA_HOME='/usr/local/cuda'
  if [ -d "${CUDA_HOME}" ] ; then
    export CUDA_HOME
    path_prepend "${CUDA_HOME}/bin"
    export LD_LIBRARY_PATH="${CUDA_HOME}/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
  fi

  # linux brew
  if [ -x '/home/linuxbrew/.linuxbrew/bin/brew' ] ; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv bash)"
    export HOMEBREW_NO_ENV_HINTS=1
    export HOMEBREW_NO_INSTALL_CLEANUP=1
  fi
fi

# mac
if [ "$(uname -s)" = 'Darwin' ] ; then
  # https://support.apple.com/en-us/HT208050
  export BASH_SILENCE_DEPRECATION_WARNING=1

  if [ -x '/opt/homebrew/bin/brew' ] ; then
    eval "$(/opt/homebrew/bin/brew shellenv bash)"
    export HOMEBREW_NO_ENV_HINTS=1
    export HOMEBREW_NO_INSTALL_CLEANUP=1
  fi
fi

# add local bin to path
if [ ! -d "${HOME}/.local/bin" ] ; then mkdir -p "${HOME}/.local/bin" ; fi
path_prepend "${HOME}/.local/bin"

# add go bin to path
export GOPATH="${HOME}/.go"
path_prepend "${GOPATH}/bin"

# add cargo bin to path
if [ -d "${HOME}/.cargo/bin" ] ; then
  path_prepend "${HOME}/.cargo/bin"
fi

# add foundry bin to path
export FOUNDRY_DIR="${HOME}/.foundry"
if [ -d "${FOUNDRY_DIR}/bin" ] ; then
  path_prepend "${FOUNDRY_DIR}/bin"
fi

# add solana bin to path
if [ -d "${HOME}/.local/share/solana/install/active_release/bin" ] ; then
  path_prepend "${HOME}/.local/share/solana/install/active_release/bin"
fi

# add dotfiles bin to path
if [ -d "${HOME}/.dotfiles/bin" ] ; then
  path_prepend "${HOME}/.dotfiles/bin"
fi
if [ -d '/workspaces/.codespaces/.persistedshare/dotfiles/bin' ] ; then
  path_prepend "/workspaces/.codespaces/.persistedshare/dotfiles/bin"
fi

# editor
if [ "${CODESPACES:-}" = 'true' ] || [ "${TERM_PROGRAM:-}" = 'vscode' ] ; then
  export VISUAL="code -w"
else
  export VISUAL='nvim'
fi
export EDITOR="$VISUAL"
export GIT_EDITOR="$EDITOR"

# pager
export LESSHISTSIZE=0
export PAGER='less -FRSX --tabs=2'

# https://wiki.archlinux.org/title/XDG_Base_Directory
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# node
export NODE_NO_WARNINGS=1
export NODE_OPTIONS='--no-deprecation'

# npm
export NPM_CONFIG_FUND=false
export NPM_CONFIG_AUDIT=false
export NPM_CONFIG_PROGRESS=false
export NPM_CONFIG_LOGLEVEL=error
export NPM_CONFIG_MIN_RELEASE_AGE=1
export NPM_CONFIG_UPDATE_NOTIFIER=false
export NPM_CONFIG_PREFIX="${HOME}/.local"

# python
export VIRTUAL_ENV_DISABLE_PROMPT=1
export PYDEVD_DISABLE_FILE_VALIDATION=1

# sklearn
export SCIKIT_LEARN_DATA="${XDG_CACHE_HOME}/scikit_learn_data"

# statsmodels
export STATSMODELS_DATA="${XDG_CACHE_HOME}/statsmodels_data"

# huggingface
export HF_HOME="${XDG_CACHE_HOME}/huggingface"
export HF_DATASETS_CACHE="${XDG_CACHE_HOME}/huggingface/datasets"
export HF_HUB_CACHE="${XDG_CACHE_HOME}/huggingface/hub"
export HF_HUB_ENABLE_HF_TRANSFER=1

# llama.cpp
LLAMA_HOME="/opt/llama-cpp"
if [ -d "${LLAMA_HOME}" ] ; then
  export LLAMA_ARG_PORT=9931
  export LLAMA_ARG_HOST='0.0.0.0'
  export LLAMA_ARG_CORS_ORIGINS='localhost'
  export LLAMA_ARG_FIT=0
  export LLAMA_ARG_LOAD_MODE='dio'
  export LLAMA_ARG_LOG_VERBOSITY=2
  export LLAMA_ARG_TOOLS='all'
  export LLAMA_ARG_N_GPU_LAYERS='all'
  export LLAMA_ARG_MODELS_MAX=1
  export LLAMA_ARG_MODELS_DIR="${HOME}/.gguf"
  export LLAMA_ARG_MODELS_PRESET="${LLAMA_ARG_MODELS_DIR}/models.ini"
  path_prepend "${LLAMA_HOME}"
fi

# stable-diffusion.cpp
STABLE_DIFFUSION_HOME="/opt/stable-diffusion-cpp"
if [ -d "${STABLE_DIFFUSION_HOME}" ] ; then
  path_prepend "${STABLE_DIFFUSION_HOME}"
fi

# opencode
export OPENCODE_EXPERIMENTAL_DISABLE_COPY_ON_SELECT=1

# ghostty
export COLORTERM=truecolor

# telemetry
export DISABLE_TELEMETRY=1
export DISABLE_ERROR_REPORTING=1
export HOMEBREW_NO_ANALYTICS=1
export ASTRO_TELEMETRY_DISABLED=1
export HF_HUB_DISABLE_TELEMETRY=1
export WRANGLER_SEND_METRICS=false

export PATH
unset -f path_prepend
