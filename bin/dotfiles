#!/usr/bin/env python3

import argparse
import bz2
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import zipfile
from pathlib import Path
from urllib.request import Request, urlopen

REPO_DIR = Path(__file__).resolve().parent.parent

# Map package name to binary name.
DEB_OVERRIDES = {"helix": "hx", "ripgrep": "rg"}

# Map expected binary name to actual filename inside the archive.
BIN_OVERRIDES = {
    "codex": lambda arch: f"codex-{arch['musl']}",
}

BIN_REGISTRY = {
    "agent-browser": ("vercel-labs/agent-browser", lambda a: f"agent-browser-linux-{a['node']}$"),
    "codex": ("openai/codex", lambda a: f"^codex-package-{a['musl']}\\.tar\\.gz$"),
    "duckdb": ("duckdb/duckdb", lambda a: f"duckdb_cli-linux-{a['misc']}\\.zip$"),
    "fastfetch": ("fastfetch-cli/fastfetch", lambda a: f"fastfetch-linux-{a['misc']}\\.tar\\.gz"),
    "fzf": ("junegunn/fzf", lambda a: f"fzf-.+-linux_{a['misc']}\\.tar\\.gz$"),
    "gh": ("cli/cli", lambda a: f"gh_.+_linux_{a['misc']}\\.tar\\.gz"),
    "gws": ("googleworkspace/cli", lambda a: f"google-workspace-cli-{a['gnu']}\\.tar\\.gz$"),
    "herdr": ("herdrdev/herdr", lambda a: f"^herdr-linux-{a['kernel']}$"),
    "lf": ("gokcehan/lf", lambda a: f"lf-linux-{a['misc']}\\.tar\\.gz"),
    "magick": ("imagemagick/imagemagick", lambda _: r"clang-x86_64\.AppImage$"),
    "micro": ("micro-editor/micro", lambda a: f"micro-.+-{a['micro']}\\.tar\\.gz$"),
    "opencode": ("anomalyco/opencode", lambda a: f"opencode-linux-{a['node']}\\.tar\\.gz"),
    "polymarket": ("polymarket/polymarket-cli", lambda a: f"polymarket-.+-{a['gnu']}\\.tar\\.gz"),
    "restic": ("restic/restic", lambda a: f"restic_.+_linux_{a['misc']}\\.bz2$"),
    "shellcheck": (
        "koalaman/shellcheck",
        lambda a: f"shellcheck-v.+\\.linux\\.{a['kernel']}\\.tar\\.gz$",
    ),
    "xurl": (
        "xdevplatform/xurl",
        lambda a: f"xurl_Linux_{'x86_64' if a['kernel'] == 'x86_64' else a['misc']}\\.tar\\.gz$",
    ),
    "yt-dlp": (
        "yt-dlp/yt-dlp",
        lambda a: (
            r"^yt-dlp_linux$" if a["kernel"] == "x86_64" else rf"^yt-dlp_linux_{a['kernel']}$"
        ),
    ),
}

# Map linker name (-l) to a header required to compile against the library.
LIB_HEADERS = {
    "json-c": "json-c/json.h",
    "ssl": "openssl/ssl.h",
    "uv": "uv.h",
    "websockets": "libwebsockets.h",
    "z": "zlib.h",
}

# Map linker name (-l) to the Debian package providing the library.
LIB_PACKAGES = {
    "json-c": "libjson-c-dev",
    "ssl": "libssl-dev",
    "uv": "libuv1-dev",
    "websockets": "libwebsockets-dev",
    "z": "zlib1g-dev",
}

CLAUDE_CHANNELS = ("latest", "stable")

MOTD_SCRIPT = """\
#!/bin/sh
fastfetch \\
--pipe false \\
--logo linux \\
--structure Logo
printf '\\n'
fastfetch \\
--pipe false \\
--logo none \\
--color-keys yellow \\
--structure-disabled Title:Separator:Host:Shell:Terminal:Display:Theme:Icons:Cursor:Swap:Locale:Break:Colors
"""


def _detect_os():
    s = platform.system()
    if s not in ("Linux", "Darwin"):
        sys.exit(f"Unsupported OS: {s}")
    return s


def _detect_arch():
    m = platform.machine()
    if m in ("aarch64", "arm64"):
        return {
            "gnu": "aarch64-unknown-linux-gnu",
            "kernel": "aarch64",
            "micro": "linux-arm64",
            "misc": "arm64",
            "musl": "aarch64-unknown-linux-musl",
            "node": "arm64",
        }
    if m in ("x86_64", "amd64"):
        return {
            "gnu": "x86_64-unknown-linux-gnu",
            "kernel": "x86_64",
            "micro": "linux64",
            "misc": "amd64",
            "musl": "x86_64-unknown-linux-musl",
            "node": "x64",
        }
    sys.exit(f"Unsupported architecture: {m}")


def _require_linux():
    if platform.system() != "Linux":
        sys.exit("This command is Linux only")


def _require_cmd(name):
    if shutil.which(name) is None:
        sys.exit(f"Required command not found: {name}")


def _has_cmd(name):
    return shutil.which(name) is not None


def _has_lib(name):
    """Compile and link a program against a library to check it is usable."""
    header = LIB_HEADERS.get(name, f"{name}.h")
    with tempfile.TemporaryDirectory() as tmpdir:
        src_path = Path(tmpdir) / "libtest.c"
        bin_path = Path(tmpdir) / "libtest"
        src_path.write_text(f"#include <{header}>\nint main(void) {{ return 0; }}\n")
        result = subprocess.run(
            ["cc", str(src_path), f"-l{name}", "-o", str(bin_path)],
            capture_output=True,
            check=False,
        )
    return result.returncode == 0


def _install_libs(*names):
    """Install the Debian packages providing the given libraries, if missing."""
    missing = [name for name in names if not _has_lib(name)]
    if not missing:
        return

    _sudo("apt-get", "update")
    _sudo(
        "env",
        "DEBIAN_FRONTEND=noninteractive",
        "apt-get",
        "install",
        "-y",
        *[LIB_PACKAGES[name] for name in missing],
    )


def _log(message):
    print(f"dotfiles: {message}")


def _sudo(*args):
    if os.geteuid() == 0:
        subprocess.run(args, check=True)
    else:
        subprocess.run(["sudo", *args], check=True)


def _github_token():
    return os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN") or ""


def _github_latest(repo):
    url = f"https://api.github.com/repos/{repo}/releases/latest"
    req = Request(url)
    token = _github_token()
    if token:
        req.add_header("Authorization", f"token {token}")
    with urlopen(req) as resp:
        return json.loads(resp.read())


def _download(url, dest):
    req = Request(url)
    token = _github_token()
    if token:
        req.add_header("Authorization", f"token {token}")
    with urlopen(req) as resp, open(dest, "wb") as f:
        while chunk := resp.read(1 << 16):
            f.write(chunk)


def _extract(archive, dest_dir):
    archive = str(archive)
    if archive.endswith((".tgz", ".tar.gz", ".tar.xz")):
        with tarfile.open(archive, "r:*") as tf:
            try:
                tf.extractall(dest_dir, filter="data")
            except TypeError:
                tf.extractall(dest_dir)
    elif archive.endswith(".zip"):
        with zipfile.ZipFile(archive) as zf:
            zf.extractall(dest_dir)
    else:
        raise ValueError(f"Unknown archive format: {archive}")


def _find_binary(directory, name):
    for root, _dirs, files in os.walk(directory):
        for file in files:
            if file == name:
                return Path(root) / file
    return None


def _write_file(path, content, mode=0o644):
    if os.geteuid() == 0:
        Path(path).write_text(content)
        os.chmod(path, mode)
    else:
        subprocess.run(
            ["sudo", "tee", path],
            input=content.encode(),
            stdout=subprocess.DEVNULL,
            check=True,
        )
        subprocess.run(["sudo", "chmod", f"{mode:o}", path], check=True)


def _append_file(path, content):
    if os.geteuid() == 0:
        with open(path, "a") as f:
            f.write(content)
    else:
        subprocess.run(
            ["sudo", "tee", "-a", path],
            input=content.encode(),
            stdout=subprocess.DEVNULL,
            check=True,
        )


# INSTALL BIN
def cmd_install_bin(args):
    _require_linux()
    arch = _detect_arch()
    name = args.name

    if name not in BIN_REGISTRY:
        sys.exit(f"Unsupported binary: {name}")

    if name == "magick" and arch["kernel"] != "x86_64":
        sys.exit("magick AppImage is amd64 only")

    if not args.force and _has_cmd(name):
        _log(f"{name} already installed (use --force)")
        return

    repo, pattern_fn = BIN_REGISTRY[name]
    pattern = pattern_fn(arch)
    release = _github_latest(repo)
    assets = release.get("assets", [])
    match = [a for a in assets if re.search(pattern, a["name"])]
    if not match:
        sys.exit(f"Asset not found for {name}")

    url = match[0]["browser_download_url"]
    filename = url.rsplit("/", 1)[-1]

    with tempfile.TemporaryDirectory() as tmpdir:
        archive_path = Path(tmpdir) / filename
        _download(url, archive_path)

        if name == "codex":
            package_dir = Path(tmpdir) / "package"
            package_dir.mkdir()
            _extract(archive_path, package_dir)
            manifest_path = package_dir / "codex-package.json"
            if not manifest_path.is_file():
                sys.exit("Codex archive has no package manifest")
            manifest = json.loads(manifest_path.read_text())
            version = manifest.get("version", "")
            if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", version):
                sys.exit("Codex package has an invalid version")
            if manifest.get("target") != arch["musl"] or manifest.get("entrypoint") != "bin/codex":
                sys.exit("Codex package has an unexpected layout")
            for binary in ("codex", "codex-code-mode-host"):
                if not (package_dir / "bin" / binary).is_file():
                    sys.exit(f"Codex package is missing {binary}")

            install_root = Path("/usr/local/lib/codex")
            install_dir = install_root / version
            _sudo("mkdir", "-p", str(install_root))
            if install_dir.exists():
                _sudo("rm", "-rf", str(install_dir))
            _sudo("mv", str(package_dir), str(install_dir))
            for binary in ("codex", "codex-code-mode-host"):
                _sudo("ln", "-sfn", str(install_dir / "bin" / binary), f"/usr/local/bin/{binary}")
            for old_dir in install_root.iterdir():
                if (
                    old_dir.name != version
                    and old_dir.is_dir()
                    and re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", old_dir.name)
                ):
                    _sudo("rm", "-rf", str(old_dir))
            return

        if filename.endswith((".zip", ".tar.gz", ".tgz")):
            extract_dir = Path(tmpdir)
            _extract(archive_path, extract_dir)
            archive_name = BIN_OVERRIDES[name](arch) if name in BIN_OVERRIDES else name
            bin_path = _find_binary(extract_dir, archive_name)
            if bin_path is None:
                sys.exit(f"Could not find {name} in archive")
            bin_path.chmod(0o755)
            _sudo("mv", str(bin_path), f"/usr/local/bin/{name}")

        elif filename.endswith(".bz2"):
            bin_path = Path(tmpdir) / name
            with bz2.open(archive_path, "rb") as src, open(bin_path, "wb") as dst:
                shutil.copyfileobj(src, dst)
            bin_path.chmod(0o755)
            _sudo("mv", str(bin_path), f"/usr/local/bin/{name}")
        else:
            archive_path.chmod(0o755)
            _sudo("mv", str(archive_path), f"/usr/local/bin/{name}")


# INSTALL DEB
def cmd_install_deb(args):
    _require_linux()
    _require_cmd("dpkg")
    arch = _detect_arch()
    repo = args.repo

    package = repo.rsplit("/", 1)[-1]
    cmd_name = DEB_OVERRIDES.get(package, package)

    if not args.force and _has_cmd(cmd_name):
        _log(f"{cmd_name} already installed (use --force)")
        return

    arch_deb = arch["misc"]
    pattern = rf"^{re.escape(package)}_.+_{arch_deb}\.deb$"
    release = _github_latest(repo)
    assets = release.get("assets", [])
    match = [a for a in assets if re.search(pattern, a["name"])]
    if not match:
        sys.exit(f"Deb not found for {repo}")

    url = match[0]["browser_download_url"]
    filename = url.rsplit("/", 1)[-1]

    with tempfile.TemporaryDirectory() as tmpdir:
        deb_path = Path(tmpdir) / filename
        _download(url, deb_path)
        _sudo("dpkg", "-i", str(deb_path))


# INSTALL UV
def cmd_install_uv(args):
    _require_linux()
    arch = _detect_arch()

    if not args.force and _has_cmd("uv") and _has_cmd("uvx"):
        _log("uv already installed (use --force)")
        return

    pattern = rf"^uv-{re.escape(arch['gnu'])}\.tar\.gz$"
    release = _github_latest("astral-sh/uv")
    assets = release.get("assets", [])
    asset = next((a for a in assets if re.search(pattern, a["name"])), None)
    if asset is None:
        sys.exit("Asset not found for uv")

    url = asset["browser_download_url"]
    filename = url.rsplit("/", 1)[-1]

    with tempfile.TemporaryDirectory() as tmpdir:
        extract_dir = Path(tmpdir)
        archive_path = extract_dir / filename
        _download(url, archive_path)
        _extract(archive_path, extract_dir)

        uv_path = _find_binary(extract_dir, "uv")
        uvx_path = _find_binary(extract_dir, "uvx")
        if uv_path is None:
            sys.exit("Could not find uv in archive")
        if uvx_path is None:
            sys.exit("Could not find uvx in archive")

        for bin_name, bin_path in (("uv", uv_path), ("uvx", uvx_path)):
            bin_path.chmod(0o755)
            _sudo("mv", str(bin_path), f"/usr/local/bin/{bin_name}")


# INSTALL BTOP
def cmd_install_btop(args):
    _require_linux()
    _require_cmd("g++-14")

    if not args.force and _has_cmd("btop"):
        _log("btop already installed (use --force)")
        return

    release = _github_latest("aristocratos/btop")
    tag = release.get("tag_name", "")
    if not tag or not re.match(r"^v\d+(\.\d+)*$", tag):
        sys.exit("Failed to resolve latest btop tag")

    with tempfile.TemporaryDirectory() as tmpdir:
        repo_dir = Path(tmpdir)
        subprocess.run(
            [
                "git",
                "clone",
                "--depth",
                "1",
                "--branch",
                tag,
                "--no-checkout",
                "https://github.com/aristocratos/btop.git",
                str(repo_dir),
            ],
            check=True,
        )
        subprocess.run(
            ["git", "-C", str(repo_dir), "switch", "--no-track", "-c", tag, tag],
            check=True,
        )
        subprocess.run(["make", "-C", str(repo_dir), "CXX=g++-14"], check=True)
        _sudo("make", "-C", str(repo_dir), "install")


# INSTALL CLAUDE CODE
def cmd_install_claude(args):
    _require_linux()
    _require_cmd("apt-get")
    _require_cmd("awk")

    sources = Path("/etc/apt/sources.list.d/claude-code.sources")
    current = None
    if sources.exists():
        for line in sources.read_text().splitlines():
            if line.startswith("URIs:"):
                current = line.rsplit("/", 1)[-1].strip()
                break

    if current != args.channel:
        req = Request("https://downloads.claude.ai/keys/claude-code.asc")
        with urlopen(req) as resp:
            key = resp.read()

        indented_key = subprocess.run(
            ["awk", '{ print ($0 == "" ? " ." : " " $0) }'],
            input=key,
            capture_output=True,
            check=True,
        ).stdout.decode()

        # Apt DEB822 sources format
        content = (
            "Types: deb\n"
            f"URIs: https://downloads.claude.ai/claude-code/apt/{args.channel}\n"
            f"Suites: {args.channel}\n"
            "Components: main\n"
            "Signed-By:\n"
            f"{indented_key}"
        )
        _write_file(str(sources), content)
    elif _has_cmd("claude"):
        return

    _sudo("apt-get", "update")
    _sudo("apt-get", "install", "claude-code")


# INSTALL FISH
def cmd_install_fish(args):
    _require_linux()
    _require_cmd("apt-get")

    if _has_cmd("fish"):
        return

    if not _has_cmd("apt-add-repository"):
        _sudo("apt-get", "update")
        _sudo(
            "env",
            "DEBIAN_FRONTEND=noninteractive",
            "apt-get",
            "install",
            "-y",
            "software-properties-common",
        )

    _sudo("apt-add-repository", "-y", "ppa:fish-shell/release-4")
    _sudo("apt-get", "update")
    _sudo("env", "DEBIAN_FRONTEND=noninteractive", "apt-get", "install", "-y", "fish")

    fish_plugins = Path.home() / ".config/fish/fish_plugins"
    if fish_plugins.exists():
        fisher_url = (
            "https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish"
        )
        subprocess.run(
            ["fish", "-c", f"curl -fsSL {fisher_url} | source && fisher update"],
            check=True,
        )


# INSTALL FOUNDRY
def cmd_install_foundry(args):
    osname = _detect_os()
    arch = _detect_arch()
    os_foundry = "darwin" if osname == "Darwin" else "linux"
    asset_name = f"foundryup_{os_foundry}_{arch['misc']}"

    if os.environ.get("FOUNDRY_DIR"):
        foundry_dir = Path(os.environ["FOUNDRY_DIR"])
    elif os.environ.get("XDG_CONFIG_HOME"):
        foundry_dir = Path(os.environ["XDG_CONFIG_HOME"]) / ".foundry"
    else:
        foundry_dir = Path.home() / ".foundry"
    bin_dir = foundry_dir / "bin"
    foundryup_path = bin_dir / "foundryup"

    if not args.force and foundryup_path.exists():
        _log("foundryup already installed (use --force)")
        return

    release = _github_latest("foundry-rs/foundryup")
    assets = release.get("assets", [])
    asset = next((a for a in assets if a["name"] == asset_name), None)
    if asset is None:
        sys.exit(f"Asset not found for foundryup: {asset_name}")

    bin_dir.mkdir(parents=True, exist_ok=True)
    _download(asset["browser_download_url"], foundryup_path)
    foundryup_path.chmod(0o755)

    subprocess.run(
        [str(foundryup_path)],
        env={**os.environ, "FOUNDRY_DIR": str(foundry_dir)},
        check=True,
    )


# INSTALL GCLOUD
def cmd_install_gcloud(args):
    _require_linux()
    _require_cmd("apt-get")
    _require_cmd("awk")

    if _has_cmd("gcloud"):
        return

    sources = Path("/etc/apt/sources.list.d/google-cloud-sdk.sources")
    if not sources.exists():
        req = Request("https://packages.cloud.google.com/apt/doc/apt-key.gpg")
        with urlopen(req) as resp:
            key = resp.read()

        indented_key = subprocess.run(
            ["awk", '{ print ($0 == "" ? " ." : " " $0) }'],
            input=key,
            capture_output=True,
            check=True,
        ).stdout.decode()

        # Apt DEB822 sources format
        content = (
            "Types: deb\n"
            "URIs: https://packages.cloud.google.com/apt\n"
            "Suites: cloud-sdk\n"
            "Components: main\n"
            "Signed-By:\n"
            f"{indented_key}"
        )
        _write_file(str(sources), content)

    _sudo("apt-get", "update")
    _sudo("apt-get", "install", "google-cloud-cli")


# INSTALL GO
def cmd_install_go(args):
    osname = _detect_os()
    arch = _detect_arch()
    arch_go = arch["misc"]
    os_go = osname.lower()

    req = Request("https://go.dev/VERSION?m=text")
    with urlopen(req) as resp:
        version = resp.read().decode().split("\n")[0].strip()
    if not version:
        sys.exit("Failed to resolve latest Go version")

    filename = f"{version}.{os_go}-{arch_go}.tar.gz"
    url = f"https://go.dev/dl/{filename}"

    with tempfile.TemporaryDirectory() as tmpdir:
        dest = Path(tmpdir) / filename
        _download(url, dest)
        _sudo("tar", "-C", "/usr/local", "-xzf", str(dest))


# INSTALL NERDFONT
def cmd_install_nerdfont(args):
    _require_linux()
    _require_cmd("fc-cache")

    name = args.name
    url = f"https://github.com/ryanoasis/nerd-fonts/releases/latest/download/{name}.zip"
    font_dir = Path.home() / ".fonts" / name

    with tempfile.TemporaryDirectory() as tmpdir:
        dest = Path(tmpdir) / f"{name}.zip"
        _download(url, dest)
        font_dir.mkdir(parents=True, exist_ok=True)
        with zipfile.ZipFile(dest) as zf:
            zf.extractall(font_dir)

    subprocess.run(["fc-cache", "-f"], check=True)


# INSTALL RUST
def cmd_install_rust(args):
    osname = _detect_os()
    arch = _detect_arch()
    arch_rust = arch["kernel"]

    if osname == "Darwin":
        os_rust = "apple-darwin"
    else:
        os_rust = "unknown-linux-gnu"

    host = f"{arch_rust}-{os_rust}"
    req = Request("https://sh.rustup.rs")
    with urlopen(req) as resp:
        installer = resp.read()

    subprocess.run(
        [
            "sh",
            "-s",
            "--",
            "-y",
            "-q",
            "--no-modify-path",
            f"--default-host={host}",
            "--default-toolchain=stable",
            "--profile=default",
        ],
        input=installer,
        check=True,
    )


# INSTALL SOLANA
def cmd_install_solana(args):
    osname = _detect_os()
    arch = _detect_arch()
    if osname == "Linux" and arch["kernel"] == "aarch64":
        sys.exit("Solana, Anchor, and Surfpool have no Linux arm64 release")

    os_target = "apple-darwin" if osname == "Darwin" else "unknown-linux-gnu"
    target = f"{arch['kernel']}-{os_target}"
    data_dir = Path.home() / ".local" / "share" / "solana" / "install"
    agave_path = data_dir / "active_release" / "bin" / "agave-install-init"

    if not args.force and agave_path.exists():
        _log("agave-install-init already installed (use --force)")
        return

    release = _github_latest("anza-xyz/agave")
    assets = release.get("assets", [])
    asset_name = f"agave-install-init-{target}"
    asset = next((a for a in assets if a["name"] == asset_name), None)
    if asset is None:
        sys.exit(f"Asset not found for agave-install-init: {asset_name}")

    with tempfile.TemporaryDirectory() as tmpdir:
        init_path = Path(tmpdir) / "agave-install-init"
        _download(asset["browser_download_url"], init_path)
        init_path.chmod(0o755)
        subprocess.run(
            [
                str(init_path),
                "--no-modify-path",
                "--data-dir",
                str(data_dir),
                "stable",
            ],
            check=True,
        )

    local_bin = Path.home() / ".local" / "bin"
    local_bin.mkdir(parents=True, exist_ok=True)

    # Anchor ships bare executables; Surfpool ships a .tar.gz per platform.
    surfpool_suffix = {
        "Linux": "linux-x64",
        "Darwin": "darwin-arm64" if arch["kernel"] == "aarch64" else "darwin-x64",
    }[osname]
    tools = [
        ("otter-sec/anchor", "anchor", rf"^anchor-.+-{re.escape(target)}$"),
        ("solana-foundation/surfpool", "surfpool", rf"^surfpool-{surfpool_suffix}\.tar\.gz$"),
    ]

    for repo, name, pattern in tools:
        release = _github_latest(repo)
        asset = next((a for a in release.get("assets", []) if re.search(pattern, a["name"])), None)
        if asset is None:
            sys.exit(f"Asset not found for {name}: {pattern}")

        with tempfile.TemporaryDirectory() as tmpdir:
            tmp = Path(tmpdir)
            download_path = tmp / asset["name"]
            _download(asset["browser_download_url"], download_path)
            if download_path.name.endswith(".tar.gz"):
                _extract(download_path, tmp)
                src = _find_binary(tmp, name)
                if src is None:
                    sys.exit(f"Could not find {name} in {asset['name']}")
            else:
                src = download_path
            src.chmod(0o755)
            dest = local_bin / name
            shutil.move(str(src), dest)


# INSTALL SYMLINKS
def cmd_install_symlinks(args):
    osname = _detect_os()
    if osname == "Darwin":
        folders = ["shared", "mac"]
    else:
        folders = ["shared", "linux"]

    for folder in folders:
        src_dir = REPO_DIR / folder
        if not src_dir.is_dir():
            sys.exit(f"Cannot find source folder: {src_dir}")

        for src_file in src_dir.rglob("*"):
            if not src_file.is_file():
                continue
            rel = src_file.relative_to(src_dir)
            dest = Path.home() / rel

            dest.parent.mkdir(parents=True, exist_ok=True)
            if dest.is_dir() and not dest.is_symlink():
                shutil.rmtree(dest)
            dest.unlink(missing_ok=True)
            dest.symlink_to(src_file.resolve())


# INSTALL TTYD
def cmd_install_ttyd(args):
    _require_linux()
    _require_cmd("apt-get")
    _require_cmd("cc")
    _require_cmd("cmake")

    _install_libs("websockets", "uv", "json-c", "ssl", "z")

    if not args.force and _has_cmd("ttyd"):
        _log("ttyd already installed (use --force)")
        return

    with tempfile.TemporaryDirectory() as tmpdir:
        repo_dir = Path(tmpdir)
        # Build main: ttyd has not tagged a release since 1.7.7 (March '24).
        # A full clone is needed for the version to be derived from git describe.
        subprocess.run(
            ["git", "clone", "https://github.com/tsl0922/ttyd.git", str(repo_dir)],
            check=True,
        )
        build_dir = repo_dir / "build"
        subprocess.run(
            ["cmake", "-B", str(build_dir), "-S", str(repo_dir), "-DCMAKE_BUILD_TYPE=Release"],
            check=True,
        )
        subprocess.run(["cmake", "--build", str(build_dir)], check=True)
        _sudo("cmake", "--install", str(build_dir))


# INSTALL ZIG
def cmd_install_zig(args):
    _require_linux()
    arch = _detect_arch()

    if not args.force and _has_cmd("zig") and _has_cmd("zls"):
        _log("zig already installed (use --force)")
        return

    req = Request("https://ziglang.org/download/index.json")
    with urlopen(req) as resp:
        index = json.loads(resp.read())

    release = _github_latest("zigtools/zls")
    zls_version = release.get("tag_name", "").removeprefix("v")
    if not re.fullmatch(r"\d+\.\d+\.\d+", zls_version):
        sys.exit("Failed to resolve latest ZLS version")

    # ZLS and Zig must share a major/minor version; patch versions may differ.
    versions = [
        v
        for v in index
        if re.fullmatch(r"\d+\.\d+\.\d+", v) and v.split(".")[:2] == zls_version.split(".")[:2]
    ]
    if not versions:
        sys.exit(f"No stable Zig version compatible with ZLS {zls_version}")
    version = max(versions, key=lambda v: tuple(int(p) for p in v.split(".")))

    target = f"{arch['kernel']}-linux"
    build = index[version].get(target)
    if build is None:
        sys.exit(f"Zig build not found for {target}")

    zig_url = build["tarball"]
    asset_name = f"zls-{target}.tar.xz"
    asset = next((a for a in release.get("assets", []) if a["name"] == asset_name), None)
    if asset is None:
        sys.exit(f"Asset not found for ZLS {zls_version}: {asset_name}")
    zls_url = asset["browser_download_url"]

    with tempfile.TemporaryDirectory() as tmpdir:
        zig_dir = Path(tmpdir) / "zig"
        zig_dir.mkdir()
        zig_archive = Path(tmpdir) / zig_url.rsplit("/", 1)[-1]
        _download(zig_url, zig_archive)
        _extract(zig_archive, zig_dir)

        # The tarball contains a single versioned directory.
        roots = [p for p in zig_dir.iterdir() if p.is_dir()]
        if len(roots) != 1:
            sys.exit("Unexpected layout in Zig archive")
        root = roots[0]

        zls_archive = Path(tmpdir) / zls_url.rsplit("/", 1)[-1]
        _download(zls_url, zls_archive)
        _extract(zls_archive, zig_dir)

        zls_path = _find_binary(zig_dir, "zls")
        if zls_path is None:
            sys.exit("Could not find zls in archive")
        shutil.move(str(zls_path), str(root / "zls"))

        (root / "zig").chmod(0o755)
        (root / "zls").chmod(0o755)

        _sudo("rm", "-rf", "/usr/local/zig")
        _sudo("mv", str(root), "/usr/local/zig")

    _sudo("ln", "-sf", "/usr/local/zig/zig", "/usr/local/bin/zig")
    _sudo("ln", "-sf", "/usr/local/zig/zls", "/usr/local/bin/zls")


# SETUP APT
def cmd_setup_apt(args):
    _require_linux()
    _require_cmd("apt-get")

    excludes = Path("/etc/dpkg/dpkg.cfg.d/excludes")
    if excludes.exists():
        _sudo("rm", "-f", str(excludes))

    unminimize = Path("/etc/update-motd.d/60-unminimize")
    if unminimize.exists():
        _sudo("rm", "-f", str(unminimize))

    if _has_cmd("dpkg-divert"):
        r = subprocess.run(
            ["dpkg-divert", "--truename", "/usr/bin/man"],
            capture_output=True,
            text=True,
            check=False,
        )
        if r.stdout.strip() == "/usr/bin/man.REAL":
            _sudo("rm", "-f", "/usr/bin/man")
            _sudo("dpkg-divert", "--quiet", "--remove", "--rename", "/usr/bin/man")

    translations = Path("/etc/apt/apt.conf.d/99translations")
    if not translations.exists():
        _sudo("mkdir", "-p", "/etc/apt/apt.conf.d")
        _write_file(str(translations), 'Acquire::Languages "none";\n')

    _sudo("apt-get", "update")


# SETUP SSHD
def cmd_setup_sshd(args):
    _require_linux()

    conf_dir = "/etc/ssh/sshd_config.d"
    _sudo("mkdir", "-p", conf_dir)
    _sudo("sh", "-c", f"rm -f {conf_dir}/*.conf")

    _write_file(f"{conf_dir}/99-no-ipv6.conf", "AddressFamily inet\n")
    _write_file(f"{conf_dir}/99-no-lastlog.conf", "PrintLastLog no\n")
    _write_file(
        f"{conf_dir}/99-no-password.conf",
        "PermitRootLogin no\n"
        "PubkeyAuthentication yes\n"
        "PasswordAuthentication no\n"
        "AuthorizedKeysFile .ssh/authorized_keys\n"
        "KbdInteractiveAuthentication no\n"
        "UsePAM yes\n",
    )


# SETUP MOTD
def cmd_setup_motd(args):
    _require_linux()
    _sudo("mkdir", "-p", "/etc/update-motd.d")
    _sudo("sh", "-c", "rm -f /etc/update-motd.d/*")
    _write_file("/etc/update-motd.d/99-fastfetch", MOTD_SCRIPT, mode=0o755)


# SETUP USER
def cmd_setup_user(args):
    _require_linux()

    user = args.user

    r = subprocess.run(["id", user], capture_output=True, check=False)
    if r.returncode == 0:
        sys.exit(f"User {user} already exists")

    _sudo("adduser", "--disabled-password", "--gecos", "", user)


# SETUP SUDO
def cmd_setup_sudo(args):
    _require_linux()

    user = args.user or os.environ.get("USER", "")
    if not user:
        sys.exit("Cannot determine user")

    r = subprocess.run(["id", user], capture_output=True, check=False)
    if r.returncode != 0:
        sys.exit(f"User {user} does not exist")

    sudoers = Path(f"/etc/sudoers.d/{user}")
    if not sudoers.exists():
        _sudo("mkdir", "-p", "/etc/sudoers.d")
        _write_file(str(sudoers), f"{user} ALL=(ALL:ALL) NOPASSWD:ALL\n", mode=0o440)


# SETUP SHELL
def cmd_setup_shell(args):
    _require_linux()

    shell = args.shell
    user = args.user or os.environ.get("USER", "")
    if not user:
        sys.exit("Cannot determine user")

    if not os.access(shell, os.X_OK):
        sys.exit(f"Shell not found: {shell}")

    shells = Path("/etc/shells").read_text()
    if shell not in shells.splitlines():
        _append_file("/etc/shells", f"{shell}\n")

    _sudo("chsh", "-s", shell, user)


def build_parser():
    parser = argparse.ArgumentParser(prog="dotfiles")
    sub = parser.add_subparsers(dest="command")

    # INSTALL
    install = sub.add_parser("install", help="Install tools and configs")
    install_sub = install.add_subparsers(dest="target")

    p = install_sub.add_parser("bin", help="Install binary from GitHub releases")
    p.add_argument("name", choices=sorted(BIN_REGISTRY.keys()))
    p.add_argument("-f", "--force", action="store_true")
    p.set_defaults(func=cmd_install_bin)

    p = install_sub.add_parser("btop", help="Install btop from source")
    p.add_argument("-f", "--force", action="store_true")
    p.set_defaults(func=cmd_install_btop)

    p = install_sub.add_parser("claude", help="Install Claude Code via apt")
    p.add_argument("-c", "--channel", choices=CLAUDE_CHANNELS, default="latest")
    p.set_defaults(func=cmd_install_claude)

    p = install_sub.add_parser("deb", help="Install Debian package from GitHub releases")
    p.add_argument("repo", metavar="ORG/REPO")
    p.add_argument("-f", "--force", action="store_true")
    p.set_defaults(func=cmd_install_deb)

    p = install_sub.add_parser("fish", help="Install Fish shell via apt")
    p.set_defaults(func=cmd_install_fish)

    p = install_sub.add_parser("foundry", help="Install foundryup and run it")
    p.add_argument("-f", "--force", action="store_true")
    p.set_defaults(func=cmd_install_foundry)

    p = install_sub.add_parser("gcloud", help="Install Google Cloud CLI via apt")
    p.set_defaults(func=cmd_install_gcloud)

    p = install_sub.add_parser("go", help="Install Go via go.dev")
    p.set_defaults(func=cmd_install_go)

    p = install_sub.add_parser("nerdfont", help="Install a Nerd Font")
    p.add_argument("name", metavar="FONT")
    p.set_defaults(func=cmd_install_nerdfont)

    p = install_sub.add_parser("rust", help="Install Rust via rustup")
    p.set_defaults(func=cmd_install_rust)

    p = install_sub.add_parser("solana", help="Install Solana CLI, Anchor, and Surfpool")
    p.add_argument("-f", "--force", action="store_true")
    p.set_defaults(func=cmd_install_solana)

    p = install_sub.add_parser("symlinks", help="Symlink dotfiles into $HOME")
    p.set_defaults(func=cmd_install_symlinks)

    p = install_sub.add_parser("ttyd", help="Install ttyd from source")
    p.add_argument("-f", "--force", action="store_true")
    p.set_defaults(func=cmd_install_ttyd)

    p = install_sub.add_parser("uv", help="Install uv and uvx from GitHub releases")
    p.add_argument("-f", "--force", action="store_true")
    p.set_defaults(func=cmd_install_uv)

    p = install_sub.add_parser("zig", help="Install Zig and zls into /usr/local/zig")
    p.add_argument("-f", "--force", action="store_true")
    p.set_defaults(func=cmd_install_zig)

    # SETUP
    setup = sub.add_parser("setup", help="System configuration")
    setup_sub = setup.add_subparsers(dest="target")

    p = setup_sub.add_parser("apt", help="Setup apt on Ubuntu")
    p.set_defaults(func=cmd_setup_apt)

    p = setup_sub.add_parser("motd", help="Setup fastfetch message of the day")
    p.set_defaults(func=cmd_setup_motd)

    p = setup_sub.add_parser("shell", help="Setup login shell for a user")
    p.add_argument("shell", metavar="SHELL")
    p.add_argument("-u", "--user", default=None, help="Target user (default: current)")
    p.set_defaults(func=cmd_setup_shell)

    p = setup_sub.add_parser("sshd", help="Setup sshd for passwordless authentication")
    p.set_defaults(func=cmd_setup_sshd)

    p = setup_sub.add_parser("sudo", help="Setup passwordless sudo for a user")
    p.add_argument("-u", "--user", default=None, help="Target user (default: current)")
    p.set_defaults(func=cmd_setup_sudo)

    p = setup_sub.add_parser("user", help="Setup a new user")
    p.add_argument("user", metavar="USER")
    p.set_defaults(func=cmd_setup_user)

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()
    if not hasattr(args, "func"):
        parser.print_help()
        sys.exit(1)
    args.func(args)


if __name__ == "__main__":
    main()
